local function GetLocalMissile()
    return Workspace:FindFirstChild("LocalMissile")
end

local function GetMissileRoot()
    local missile = GetLocalMissile()
    if not missile then
        return nil
    end

    if missile:IsA("BasePart") then
        return missile
    end

    if missile:IsA("Model") then
        return missile.PrimaryPart or missile:FindFirstChildWhichIsA("BasePart", true)
    end

    return nil
end

local function GetCharacterRoot()
    local character = LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

-- The game's MissileClient does not drive the rocket by physics alone.
-- It stores the REAL flight position/rotation in local state and then calls
-- MissileRig.place(LocalMissile, flightCFrame) every frame. Moving only the
-- PrimaryPart makes one rocket piece jump while MissileClient keeps drawing
-- the rest of the rig at the old flight position.
--
-- Wave exposes getgc(), so we locate MissileClient's small internal API table:
--   api.get() -> mode, missile, position, velocity, rotation, ...
--   api.set() -> position, velocity, rotation, ...
-- Updating that state is what makes the WHOLE rocket teleport and stay there.

local CachedMissileAPI = nil

local function ValidateMissileAPI(api)
    if type(api) ~= "table" then
        return false
    end

    local getState = rawget(api, "get")
    local setState = rawget(api, "set")
    local hitTarget = rawget(api, "hitTarget")

    if type(getState) ~= "function"
        or type(setState) ~= "function"
        or type(hitTarget) ~= "function" then
        return false
    end

    local ok, mode, missile, position = pcall(getState)
    if not ok or type(mode) ~= "string" or typeof(position) ~= "Vector3" then
        return false
    end

    if missile ~= nil and typeof(missile) ~= "Instance" then
        return false
    end

    return true
end

local function FindMissileAPI()
    if ValidateMissileAPI(CachedMissileAPI) then
        return CachedMissileAPI
    end

    CachedMissileAPI = nil

    if type(getgc) ~= "function" then
        return nil
    end

    local ok, objects = pcall(getgc, true)
    if not ok or type(objects) ~= "table" then
        ok, objects = pcall(getgc)
    end

    if not ok or type(objects) ~= "table" then
        return nil
    end

    for _, object in ipairs(objects) do
        if type(object) == "table" then
            local success, valid = pcall(ValidateMissileAPI, object)
            if success and valid then
                CachedMissileAPI = object
                return object
            end
        end
    end

    return nil
end

local function GetMissileClientState()
    local api = FindMissileAPI()
    if not api then
        return nil
    end

    local results = table.pack(pcall(api.get))
    if not results[1] then
        CachedMissileAPI = nil
        return nil
    end

    return {
        API = api,
        Mode = results[2],
        Missile = results[3],
        Position = results[4],
        Velocity = results[5],
        Rotation = results[6],
        Rotation2 = results[7],
        Rotation3 = results[8],
        Fuel = results[9],
        Stats = results[10],
        Yaw = results[11],
        Pitch = results[12],
    }
end

local function IsMissileFlying()
    local state = GetMissileClientState()
    if state then
        return state.Mode == "flight", state
    end

    return LocalPlayer:GetAttribute("InRun") == true, nil
end

