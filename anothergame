    }
end

local function UpdateESP()
    if not State.TargetESP then
        ClearESP()
        return
    end

    for _, target in ipairs(TargetCache) do
        if IsTargetAllowed(target) then
            AddESP(target)

            local data = ESPObjects[target]
            local position = GetTargetPosition(target)
            local root = GetCharacterRoot()

            if data and data.Label and position then
                local distance = root and (root.Position - position).Magnitude or 0
                local targetType = tostring(target:GetAttribute("TargetType") or target.Name)
                local points = GetTargetPoints(target)

                data.Label.Text = string.format(
                    "%s  •  %d pts\n%d studs",
                    targetType,
                    points,
                    math.floor(distance)
                )
            end
        else
            RemoveESP(target)
        end
    end

    for target in pairs(ESPObjects) do
        if not IsTargetAllowed(target) then
            RemoveESP(target)
        end
    end
end

