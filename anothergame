--==========================================================
-- MAIN AUTOMATION LOOP
--==========================================================

task.spawn(function()
    local LastTargetRefresh = 0
    local LastLaunch = 0
    local LastMini = 0
    local LastCoreUpgrade = 0
    local LastAbilityUpgrade = 0
    local LastEvolve = 0
    local LastQuest = 0
    local LastAchievement = 0
    local LastPlaytime = 0
    local LastEquip = 0
    local LastDashboard = 0
    local LastESP = 0

    while State.Running do
        local now = os.clock()

        if now - LastTargetRefresh >= 1.5 then
            LastTargetRefresh = now
            RebuildTargetCache()
        end

        if State.AutoLaunch
            and not State.StudFarm
            and not State.MoveFarm
            and not State.AutoCompleteWorld1
            and now - LastLaunch >= 1 then
            local inRun = LocalPlayer:GetAttribute("InRun") == true
            local missile = GetLocalMissile()

            if missile and not inRun then
                LastLaunch = now
                TapKey(Enum.KeyCode.Space)
            end
        end

        local flying = LocalPlayer:GetAttribute("InRun") == true

        if State.AutoBoost
            and flying
            and not State.StudFarm
            and not State.MoveFarm
            and not State.AutoTargetFarm
            and not State.AutoCompleteWorld1 then
            if not BoostHeld then
                HoldKey(Enum.KeyCode.Space, true)
                BoostHeld = true
            end
        elseif BoostHeld then
            HoldKey(Enum.KeyCode.Space, false)
            BoostHeld = false
        end

        if State.AutoMiniRockets and flying and now - LastMini >= 0.8 then
            LastMini = now

            local key = Enum.KeyCode.G
            if Config and typeof(Config.MiniRocketKey) == "EnumItem" then
                key = Config.MiniRocketKey
            end

            TapKey(key)
        end

        if State.AutoCoreUpgrades and now - LastCoreUpgrade >= 1.5 then
            LastCoreUpgrade = now
            task.spawn(BuyList, CoreUpgrades)
        end

        if State.AutoAbilities and now - LastAbilityUpgrade >= 3 then
            LastAbilityUpgrade = now
            task.spawn(BuyList, Abilities)
        end

        if State.AutoEvolve and Evolve and now - LastEvolve >= 2.5 then
            LastEvolve = now
            pcall(function()
                Evolve:FireServer()
            end)
        end

        if State.AutoQuests and now - LastQuest >= 8 then
            LastQuest = now
            task.spawn(ClaimAllQuests)
        end

        if State.AutoAchievements and now - LastAchievement >= 10 then
            LastAchievement = now
            task.spawn(ClaimAllAchievements)
        end

        if State.AutoPlaytime and now - LastPlaytime >= 10 then
            LastPlaytime = now
            task.spawn(ClaimAllPlaytime)
        end

        if State.AutoEquipBest and now - LastEquip >= 10 then
            LastEquip = now
            task.spawn(EquipBest)
        end

        if now - LastDashboard >= 0.35 then
            LastDashboard = now
            UpdateDashboard()
        end

        if now - LastESP >= 0.35 then
            LastESP = now
            UpdateESP()
        end

        task.wait(0.03)
    end
end)

