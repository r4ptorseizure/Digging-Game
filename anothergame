local function CollectTableIDs(source)
    local ids = {}
    local seenTables = {}
    local seenIDs = {}

    local function Add(value)
        if type(value) ~= "string" and type(value) ~= "number" then
            return
        end

        local key = tostring(value)
        if seenIDs[key] then
            return
        end

        seenIDs[key] = true
        table.insert(ids, value)
    end

    local function Scan(current, depth)
        if type(current) ~= "table" or seenTables[current] or depth > 7 then
            return
        end

        seenTables[current] = true

        if current.id ~= nil then Add(current.id) end
        if current.Id ~= nil then Add(current.Id) end
        if current.ID ~= nil then Add(current.ID) end

        for key, value in pairs(current) do
            if type(value) == "table" then
                if type(key) == "string" then
                    if value.Goal ~= nil
                        or value.goal ~= nil
                        or value.Reward ~= nil
                        or value.reward ~= nil
                        or value.Description ~= nil
                        or value.description ~= nil
                        or value.Title ~= nil
                        or value.title ~= nil then

                        Add(key)
                    end
                end

                Scan(value, depth + 1)
            end
        end
    end

    Scan(source, 0)
    return ids
end

