local function Unload()
    if not State.Running then
        return
    end

    State.Running = false

    if BoostHeld then
        HoldKey(Enum.KeyCode.Space, false)
        BoostHeld = false
    end

    ClearESP()
    DestroyStudFarmWall()

    if Config then
        Config.UnlimitedFuel = OriginalUnlimitedFuel
    end

    if RocketStats then
        if OriginalApplyUpgrades then
            RocketStats.applyUpgrades = OriginalApplyUpgrades
        end

        if OriginalApplyLaunchUpgrade then
            RocketStats.applyLaunchUpgrade = OriginalApplyLaunchUpgrade
        end
    end

    for _, connection in ipairs(Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(Connections)

    pcall(function()
        GUI:Destroy()
    end)

    getgenv().CharlesRocketRush = nil
end

