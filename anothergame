local function RemoveESP(target)
    local data = ESPObjects[target]
    if data then
        for _, object in pairs(data) do
            pcall(function()
                object:Destroy()
            end)
        end
    end
    ESPObjects[target] = nil
end

local function ClearESP()
    for target in pairs(ESPObjects) do
