local function NumberFormat(number)
    number = tonumber(number) or 0
    local text = tostring(math.floor(number))
    return text:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
end

local function DescribeTarget(target)
    if not target or not target.Parent then
        return "None"
    end

    local targetType = tostring(target:GetAttribute("TargetType") or target.Name)
    return string.format("%s (%d pts)", targetType, GetTargetPoints(target))
end

local function UpdateDashboard()
    CoinsValue.Text = NumberFormat(LocalPlayer:GetAttribute("Coins"))
    EvolvesValue.Text = tostring(LocalPlayer:GetAttribute("Evolves") or 0)
    TotalDistanceValue.Text = NumberFormat(GetTotalDistance())
    TotalMovesValue.Text = NumberFormat(GetTotalMoves())
    EvolveDistanceValue.Text = NumberFormat(GetDistanceSinceEvolve())
    RocketValue.Text = tostring(LocalPlayer:GetAttribute("RocketType") or "Unknown")
    LauncherValue.Text = tostring(
        LocalPlayer:GetAttribute("Launcher")
        or LocalPlayer:GetAttribute("EquippedLauncher")
        or "Unknown"
    )

    if LocalPlayer:GetAttribute("InRace") == true then
        RunValue.Text = "Race"
    elseif LocalPlayer:GetAttribute("InRun") == true then
        RunValue.Text = "Flying"
    elseif GetLocalMissile() then
        RunValue.Text = "Launcher"
    else
        RunValue.Text = "Idle"
    end

    TargetsValue.Text = tostring(#TargetCache)

    local best = GetBestTarget()
    BestTargetValue.Text = DescribeTarget(best)
    FarmTargetValue.Text = State.AutoTargetFarm and DescribeTarget(CurrentFarmTarget) or "Off"

    EngineValue.Text = tostring(LocalPlayer:GetAttribute("Upgrade_Engine") or 0)
    FuelValue.Text = tostring(LocalPlayer:GetAttribute("Upgrade_Fuel") or 0)
    HandlingValue.Text = tostring(LocalPlayer:GetAttribute("Upgrade_Handling") or 0)
    LaunchValue.Text = tostring(LocalPlayer:GetAttribute("Upgrade_Launch") or 0)

    if StudFarmStatusValue then
        StudFarmStatusValue.Text = State.StudFarm and StudFarmPhase or "Off"
    end

    if StudFarmRunsValue then
        StudFarmRunsValue.Text = tostring(StudFarmRuns)
    end

    if StudFarmSessionValue then
        local sessionGain = math.max(0, GetTotalDistance() - StudFarmSessionStartTotal)
        StudFarmSessionValue.Text = NumberFormat(sessionGain)
    end

    if MoveFarmStatusValue then
        MoveFarmStatusValue.Text = State.MoveFarm and CurrentMoveFarmType() or "Off"
    end

    if MoveFarmTotalValue then
        MoveFarmTotalValue.Text = NumberFormat(GetTotalMoves())
    end

    if MoveFarmSessionValue then
        MoveFarmSessionValue.Text = NumberFormat(math.max(0, GetTotalMoves() - MoveFarmSessionStart))
    end
end

