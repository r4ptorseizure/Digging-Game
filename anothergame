local function IsTargetAlive(target)
    return target
        and target.Parent
        and target:IsA("Model")
        and target:GetAttribute("TargetType") ~= nil
        and target:GetAttribute("Destroyed") ~= true
end

local function IsTargetAllowed(target)
    if not IsTargetAlive(target) then
        return false
    end

    local kind = tostring(target:GetAttribute("TargetType") or "")
    local lower = string.lower(kind)

    if lower == "tank" or string.find(lower, "tank", 1, true) then
        return State.Tank
    end

    if lower == "helicopter" or string.find(lower, "heli", 1, true) then
        return State.Helicopter
    end

    if lower == "antiair" or string.find(lower, "anti", 1, true) or string.find(lower, "air", 1, true) then
        return State.AntiAir
    end

    return true
end

local function GetTargetPosition(target)
    if not target then
        return nil
    end

    if target:IsA("Model") then
        local ok, pivot = pcall(target.GetPivot, target)
        if ok and pivot then
            return pivot.Position
        end
    end

    local part = target:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

local function GetTargetPoints(target)
    if not target then
        return 0
    end

    local targetType = target:GetAttribute("TargetType")

    if Config and type(Config.TargetTypes) == "table" then
        local info = Config.TargetTypes[targetType]
        if type(info) == "table" then
            return tonumber(info.Points) or 0
        end
    end

    -- Current Rocket Rush defaults, used only if the module cannot be read.
    if targetType == "Helicopter" then
        return 40
    elseif targetType == "AntiAir" then
        return 35
    elseif targetType == "Tank" then
        return 25
    end

    return 0
end

local function AddTargetCandidate(object, results, seen)
    if not object
        or not object:IsA("Model")
        or object:GetAttribute("TargetType") == nil
        or seen[object] then

        return
    end

    seen[object] = true
    table.insert(results, object)
end

local function AddTargetsFrom(root, results, seen)
    if not root then
        return
    end

    AddTargetCandidate(root, results, seen)

    -- Use descendants rather than only direct children. Some vehicle groups in
    -- Rocket Rush are nested beneath map/course containers.
    for _, object in ipairs(root:GetDescendants()) do
        AddTargetCandidate(object, results, seen)
    end
end

local function RebuildTargetCache()
    local results = {}
    local seen = {}

    -- Fast-path the folders used by TargetClient.
    local worldGame = Workspace:FindFirstChild("MissileGame")
    if worldGame then
        AddTargetsFrom(worldGame:FindFirstChild("Targets"), results, seen)

        if Config and type(Config.ExtraTargetFolders) == "table" then
            for _, folderName in ipairs(Config.ExtraTargetFolders) do
                AddTargetsFrom(worldGame:FindFirstChild(folderName), results, seen)
            end
        else
            AddTargetsFrom(worldGame:FindFirstChild("Anti_Aircraft"), results, seen)
        end
    end

    -- Some builds/maps also keep target groups outside workspace.MissileGame.
    local freeRoam = Workspace:FindFirstChild("FreeRoam")
    if freeRoam then
        AddTargetsFrom(freeRoam:FindFirstChild("FreeroamTARGETS"), results, seen)
        AddTargetsFrom(freeRoam:FindFirstChild("Targets"), results, seen)
    end

    -- IMPORTANT:
    -- Do this EVERY refresh, not only when the normal folders are empty.
    -- The old fallback behavior was why Auto Farm could appear to see only
    -- the vehicles around the current area.
    for _, object in ipairs(Workspace:GetDescendants()) do
        AddTargetCandidate(object, results, seen)
    end

    TargetCache = results
    return results
end

local function GetDistanceReferencePosition()
    local missileRoot = GetMissileRoot()
    if missileRoot then
        return missileRoot.Position
    end

    local characterRoot = GetCharacterRoot()
    if characterRoot then
        return characterRoot.Position
    end

    return Vector3.zero
end

-- Highest points first. Distance only breaks ties.
local function GetBestTarget()
    local reference = GetDistanceReferencePosition()
    local bestTarget = nil
    local bestPoints = -math.huge
    local bestDistance = math.huge

    for _, target in ipairs(TargetCache) do
        if IsTargetAllowed(target) then
            local position = GetTargetPosition(target)
            if position then
                local points = GetTargetPoints(target)
                local distance = (position - reference).Magnitude

                if points > bestPoints or (points == bestPoints and distance < bestDistance) then
                    bestTarget = target
                    bestPoints = points
                    bestDistance = distance
                end
            end
        end
    end

    return bestTarget, bestPoints, bestDistance
end

local function GetNearestTarget(position)
    local bestTarget
    local bestDistance = math.huge

    for _, target in ipairs(TargetCache) do
        if IsTargetAllowed(target) then
            local targetPosition = GetTargetPosition(target)
            if targetPosition then
                local distance = (targetPosition - position).Magnitude
                if distance < bestDistance then
                    bestDistance = distance
                    bestTarget = target
                end
            end
        end
    end

    return bestTarget, bestDistance
end

--==========================================================
-- TARGET BOUNDS / SAFE EXTERIOR PLACEMENT
--==========================================================

local function GetModelBounds(model)
    if not model or not model:IsA("Model") then
        return nil
    end

    local ok, boxCFrame, boxSize = pcall(model.GetBoundingBox, model)
    if ok and typeof(boxCFrame) == "CFrame" and typeof(boxSize) == "Vector3" then
        return boxCFrame, boxSize
    end

    local position = GetTargetPosition(model)
    if position then
        return CFrame.new(position), Vector3.new(6, 6, 6)
    end

    return nil, nil
end

local function GetMissileExtent(missile)
    if not missile then
        return 4
    end

    if missile:IsA("Model") then
        local ok, size = pcall(missile.GetExtentsSize, missile)
        if ok and typeof(size) == "Vector3" then
            -- We point the missile toward the target. Using half of its largest
            -- dimension guarantees the model's center is not placed inside a
            -- vehicle even if the rocket is unusually long.
            return math.max(size.X, size.Y, size.Z) * 0.5
        end
    elseif missile:IsA("BasePart") then
        return math.max(missile.Size.X, missile.Size.Y, missile.Size.Z) * 0.5
    end

    return 4
end

local function GetClosestPointOnTargetBounds(target, worldPosition)
    local boxCFrame, boxSize = GetModelBounds(target)
    if not boxCFrame then
        return GetTargetPosition(target)
    end

    local half = boxSize * 0.5
    local localPoint = boxCFrame:PointToObjectSpace(worldPosition)

    local clamped = Vector3.new(
        math.clamp(localPoint.X, -half.X, half.X),
        math.clamp(localPoint.Y, -half.Y, half.Y),
        math.clamp(localPoint.Z, -half.Z, half.Z)
    )

    return boxCFrame:PointToWorldSpace(clamped)
end

local function GetOutsideTargetPlacement(target, missile)
    local boxCFrame, boxSize = GetModelBounds(target)
    if not boxCFrame then
        return nil
    end

    local halfX = boxSize.X * 0.5
    local halfZ = boxSize.Z * 0.5

    -- Exit through the vehicle's narrowest horizontal side. That gives the
    -- most room to keep the whole rocket outside while remaining within the
    -- server's target-hit distance.
    local direction
    local targetHalfExtent

    if halfX <= halfZ then
        direction = boxCFrame.RightVector
        targetHalfExtent = halfX
    else
        direction = boxCFrame.LookVector
        targetHalfExtent = halfZ
    end

    -- Use whichever side is closest to the rocket's current location. This
    -- prevents unnecessary flips through the vehicle when moving target-to-target.
    local missileRoot = GetMissileRoot()
    if missileRoot then
        local relative = missileRoot.Position - boxCFrame.Position
        if relative:Dot(direction) < 0 then
            direction = -direction
        end
    end

    local missileHalfExtent = GetMissileExtent(missile)
    local extraClearance = math.max(1, State.FarmTeleportOffset)

    local requiredDistance =
        targetHalfExtent
        + missileHalfExtent
        + extraClearance

    -- TargetHitRange is 30 in this place. Keep a small validation margin.
    local hitRange = tonumber(Config and Config.TargetHitRange) or 30
    local maxCenterDistance = math.max(8, hitRange - 2)

    -- If an unusually large model would push the missile beyond hit range,
    -- favor server hit validation while still staying beyond the target hull.
    local minimumOutside = targetHalfExtent + math.min(extraClearance, 2)
    local distance = math.clamp(
        requiredDistance,
        minimumOutside,
        math.max(minimumOutside, maxCenterDistance)
    )

    local teleportPosition =
        boxCFrame.Position
        + direction * distance

    -- Aim at the vehicle center. The entire missile stays outside its bounds.
    local aimPosition = boxCFrame.Position
    local desiredFlightCFrame = CFrame.lookAt(
        teleportPosition,
        aimPosition
    )

    return desiredFlightCFrame, aimPosition, boxCFrame, boxSize
end

--==========================================================
-- BEST VEHICLE TP FARM
--==========================================================

local function TeleportMissileToTarget(target)
    if not IsTargetAlive(target) then
        return false
    end

    local missile = GetLocalMissile()
    if not missile then
        return false
    end

    local desiredFlightCFrame, targetPosition =
        GetOutsideTargetPlacement(target, missile)

    if not desiredFlightCFrame or not targetPosition then
        return false
    end

    local teleportPosition = desiredFlightCFrame.Position
    local desiredRotation = desiredFlightCFrame.Rotation

    -- Update MissileClient's real flight state first so the game cannot snap
    -- the rocket back to its previous position on the next simulation frame.
    local state = GetMissileClientState()
    if state and state.Mode == "flight" and state.API then
        if state.Missile and state.Missile.Parent then
            missile = state.Missile

            -- Recalculate once using the exact missile instance owned by
            -- MissileClient, since different rocket models have different sizes.
            local recalculated =
                GetOutsideTargetPlacement(target, missile)

            if recalculated then
                desiredFlightCFrame = recalculated
                teleportPosition = desiredFlightCFrame.Position
                desiredRotation = desiredFlightCFrame.Rotation
            end
        end

        pcall(function()
            state.API.set(
                teleportPosition,
                Vector3.zero,
                desiredRotation,
                desiredRotation,
                desiredRotation,
                state.Fuel,
                state.Yaw,
                state.Pitch
            )
        end)
    end

    -- Move the COMPLETE missile model with the game's own rig function.
    local moved = false

    if missile:IsA("Model") then
        if MissileRig and type(MissileRig.place) == "function" then
            moved = pcall(function()
                MissileRig.place(missile, desiredFlightCFrame)
            end)
        end

        if not moved then
            moved = pcall(function()
                missile:PivotTo(desiredFlightCFrame)
            end)
        end

        for _, descendant in ipairs(missile:GetDescendants()) do
            if descendant:IsA("BasePart") then
                pcall(function()
                    descendant.AssemblyLinearVelocity = Vector3.zero
                    descendant.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        end
    elseif missile:IsA("BasePart") then
        moved = pcall(function()
            missile.AssemblyLinearVelocity = Vector3.zero
            missile.AssemblyAngularVelocity = Vector3.zero
            missile.CFrame = desiredFlightCFrame
        end)
    end

    return moved
end


--==========================================================
-- WORLD 1 END TP
--==========================================================

local function GetWorld1EndPad()
    -- Best source: use the exact pad selected by Rocket Rush's Landing module.
    if Landing and type(Landing.pad) == "function" then
        local ok, pad = pcall(Landing.pad)
        if ok and typeof(pad) == "Instance" and pad:IsA("BasePart") then
            return pad
        end
    end

    -- Fallback to the known World 1 end hierarchy from the place file:
    -- workspace.RocketCourse.Obstacles["9_End"]
    local rocketCourse = Workspace:FindFirstChild("RocketCourse")
    local obstacles = rocketCourse and rocketCourse:FindFirstChild("Obstacles")
    local endSection = obstacles and obstacles:FindFirstChild("9_End")

    if not endSection then
        return nil
    end

    local bestPart = nil
    local bestScore = -math.huge

    for _, object in ipairs(endSection:GetDescendants()) do
        if object:IsA("BasePart") then
            local lower = string.lower(object.Name)
            local score = 0

            -- Avoid choosing one of the decorative landing beacon lamps.
            if object:FindFirstAncestor("LandingBeacons") then
                score -= 1000
            end

            if string.find(lower, "landing") then
                score += 220
            end
            if string.find(lower, "finish") then
                score += 200
            end
            if string.find(lower, "end") then
                score += 160
            end
            if string.find(lower, "pad") then
                score += 260
            end
            if string.find(lower, "platform") then
                score += 80
            end

            -- Prefer a broad landing surface over tiny decorative pieces.
            local size = object.Size
            score += math.min(size.X * size.Z, 2500) * 0.02
            score += math.min(math.max(size.X, size.Y, size.Z), 200) * 0.03

            if score > bestScore then
                bestScore = score
                bestPart = object
            end
        end
    end

    return bestPart
end

local function GetWorld1EndSurface()
    -- Landing.surface() is exactly what MissileClient uses. It returns the
    -- end-pad surface position and capture radius.
    if Landing and type(Landing.surface) == "function" then
        local ok, surfacePosition, radius = pcall(Landing.surface)
        if ok and typeof(surfacePosition) == "Vector3" then
            return surfacePosition, tonumber(radius) or 0, GetWorld1EndPad()
        end
    end

    local pad = GetWorld1EndPad()
    if not pad then
        return nil, 0, nil
    end

    -- Generic fallback for normal horizontal pads.
    local surfacePosition = pad.Position + Vector3.new(0, pad.Size.Y * 0.5, 0)
    local radius = math.min(pad.Size.X, pad.Size.Z) * 0.5
    return surfacePosition, radius, pad
end

local function GetWorld1PadTopSurface()
    local surfacePosition, radius, pad = GetWorld1EndSurface()
    if not surfacePosition then
        return nil, 0, nil
    end

    -- Landing.surface() is the game's source of truth.  When a real pad part
    -- is available, also raycast ONLY against that pad and use the higher of
    -- the two Y values.  This guarantees we never calculate a point beneath
    -- the landing geometry, even if the pad is rotated or its dimensions are
    -- unusual.
    if pad and pad:IsA("BasePart") then
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances = {pad}
        params.IgnoreWater = true

        local origin = Vector3.new(
            surfacePosition.X,
            math.max(surfacePosition.Y, pad.Position.Y) + 150,
            surfacePosition.Z
        )

        local result = Workspace:Raycast(
            origin,
            Vector3.new(0, -300, 0),
            params
        )

        if result then
            surfacePosition = Vector3.new(
                surfacePosition.X,
                math.max(surfacePosition.Y, result.Position.Y),
                surfacePosition.Z
            )
        end
    end

    return surfacePosition, radius, pad
end

local function GetUprightHeading(pad)
    -- LookVector is the missile's nose direction in MissileClient.  We force
    -- it to +Y (straight into the sky).  This horizontal vector is only used
    -- to stabilize roll around that vertical axis.
    if pad then
        local candidates = {
            pad.CFrame.LookVector,
            pad.CFrame.RightVector,
            pad.CFrame.UpVector,
        }

        for _, candidate in ipairs(candidates) do
            local flat = Vector3.new(candidate.X, 0, candidate.Z)
            if flat.Magnitude > 0.05 then
                return flat.Unit
            end
        end
    end

    return Vector3.new(0, 0, 1)
end

local function PlaceMissileUprightAtWorld1End(heightAbovePad, downwardSpeed)
    if WorldConfig and type(WorldConfig.current) == "function" then
        local ok, currentWorld = pcall(WorldConfig.current)
        if ok and currentWorld ~= "World1" then
            return false, "not_world1"
        end
    end

    local missile = GetLocalMissile()
    if not missile then
        return false, "no_missile"
    end

    local state = GetMissileClientState()
    if not state or state.Mode ~= "flight" then
        return false, "not_flying"
    end

    if state.Missile and state.Missile.Parent then
        missile = state.Missile
    end

    local surfacePosition, _, pad = GetWorld1PadTopSurface()
    if not surfacePosition then
        return false, "no_pad"
    end

    local tailLength = 3.5
    if MissileRig and type(MissileRig.tailLength) == "function" then
        local ok, result = pcall(MissileRig.tailLength, missile)
        if ok and type(result) == "number" then
            tailLength = result
        end
    end

    -- Never allow the tail to be placed at or below the pad surface.
    heightAbovePad = math.max(0.75, tonumber(heightAbovePad) or State.World1CaptureHeight)
    downwardSpeed = math.clamp(tonumber(downwardSpeed) or 0, -7, 0)

    local teleportPosition =
        surfacePosition
        + Vector3.new(0, tailLength + heightAbovePad, 0)

    local desiredFlightCFrame = CFrame.lookAlong(
        teleportPosition,
        Vector3.new(0, 1, 0), -- NOSE STRAIGHT UP
        GetUprightHeading(pad)
    )

    local desiredRotation = desiredFlightCFrame.Rotation
    local desiredVelocity = Vector3.new(0, downwardSpeed, 0)

    -- Write MissileClient's actual simulation state before drawing the model,
    -- otherwise its next frame would restore the old position/orientation.
    pcall(function()
        state.API.set(
            teleportPosition,
            desiredVelocity,
            desiredRotation,
            desiredRotation,
            desiredRotation,
            state.Fuel,
            state.Yaw,
            state.Pitch
        )
    end)

    local moved = false

    if missile:IsA("Model") then
        if MissileRig and type(MissileRig.place) == "function" then
            moved = pcall(function()
                MissileRig.place(missile, desiredFlightCFrame)
            end)
        end

        if not moved then
            moved = pcall(function()
                missile:PivotTo(desiredFlightCFrame)
            end)
        end

        for _, descendant in ipairs(missile:GetDescendants()) do
            if descendant:IsA("BasePart") then
                pcall(function()
                    descendant.AssemblyLinearVelocity = desiredVelocity
                    descendant.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        end
    elseif missile:IsA("BasePart") then
        moved = pcall(function()
            missile.AssemblyLinearVelocity = desiredVelocity
            missile.AssemblyAngularVelocity = Vector3.zero
            missile.CFrame = desiredFlightCFrame
        end)
    end

    return moved, moved and "ok" or "move_failed"
end

local function TeleportMissileToWorld1End()
    -- Manual TP uses a safe, visibly-above-ground position first.  A short
    -- delay then lowers the TAIL into the normal capture zone while keeping
    -- the nose vertical.  It never places the tail below the pad surface.
    local moved, reason = PlaceMissileUprightAtWorld1End(State.World1SafeHeight, 0)
    if not moved then
        if reason == "not_world1" then
            warn("[Charles's Rocket Rush Tool] World 1 End TP only works in World 1.")
        elseif reason == "not_flying" or reason == "no_missile" then
            warn("[Charles's Rocket Rush Tool] Launch the rocket first.")
        else
            warn("[Charles's Rocket Rush Tool] Could not place the rocket at the World 1 end pad.")
        end
        return false
    end

    task.delay(0.30, function()
        if State.Running then
            PlaceMissileUprightAtWorld1End(State.World1CaptureHeight, -1.5)
        end
    end)

    return true
end

local function ResetWorld1AutoComplete()
    World1AutoPhase = "idle"
    World1AutoPhaseSince = 0
    World1LastLaunchAttempt = 0
end

local function FinishWorld1AutoComplete()
    State.AutoCompleteWorld1 = false
    ResetWorld1AutoComplete()

    if World1AutoToggleControl then
        pcall(function()
            World1AutoToggleControl.Set(false)
        end)
    end

    print("[Charles's Rocket Rush Tool] World 1 auto-complete finished.")
end

local function StepAutoCompleteWorld1()
    if not State.AutoCompleteWorld1 then
        ResetWorld1AutoComplete()
        return
    end

    if WorldConfig and type(WorldConfig.current) == "function" then
        local ok, currentWorld = pcall(WorldConfig.current)
        if ok and currentWorld ~= "World1" then
            warn("[Charles's Rocket Rush Tool] Auto Complete World 1 stopped: you are not in World 1.")
            FinishWorld1AutoComplete()
            return
        end
    end

    local landingApproach = LocalPlayer:GetAttribute("LandingApproach")
    local state = GetMissileClientState()

    -- MissileClient changes its internal mode away from flight as soon as its
    -- real landing capture succeeds.  LandingApproach='landed' is an even more
    -- explicit success signal.
    if landingApproach == "landed"
        or (World1AutoPhase == "capture" and state and state.Mode ~= "flight") then
        FinishWorld1AutoComplete()
        return
    end

    if not state or state.Mode ~= "flight" then
        local now = os.clock()
        if now - World1LastLaunchAttempt >= 0.75 then
            World1LastLaunchAttempt = now
            TapKey(Enum.KeyCode.Space)
        end
        return
    end

    local now = os.clock()

    if World1AutoPhase == "idle" then
        World1AutoPhase = "safe"
        World1AutoPhaseSince = now
    end

    if World1AutoPhase == "safe" then
        -- Hold it well above the pad first so the rocket is never embedded in
        -- terrain.  Nose points straight into the sky, matching your example.
        PlaceMissileUprightAtWorld1End(State.World1SafeHeight, 0)

        if now - World1AutoPhaseSince >= 0.35 then
            World1AutoPhase = "capture"
            World1AutoPhaseSince = now
        end
        return
    end

    if World1AutoPhase == "capture" then
        -- The game's default landing CaptureHeight is 3 studs.  1.35 studs
        -- keeps the tail safely ABOVE the pad while remaining in capture range.
        PlaceMissileUprightAtWorld1End(State.World1CaptureHeight, -1.5)

        -- If something interrupts landing, restage instead of ever pushing the
        -- rocket farther into the floor.
        if now - World1AutoPhaseSince >= 4 then
            World1AutoPhase = "safe"
            World1AutoPhaseSince = now
        end
    end
end


--==========================================================
-- MILLION STUD CRASH FARM
--==========================================================
--
-- Distance leaderboard:
--   workspace leaderboard "Distance" -> LocalPlayer.TotalDistance
--
-- MissileClient displays run distance from horizontal launch/end displacement,
-- so Y/altitude does not add distance.  This farm uses a CLIENT-SIDE wall at
-- the destination and lets MissileClient collide with it normally.  That means
-- the game itself enters its Explode path instead of us only changing a label.

local function GetTotalDistance()
    return math.max(0, tonumber(LocalPlayer:GetAttribute("TotalDistance")) or 0)
end

local function GetDistanceSinceEvolve()
    return math.max(0, tonumber(LocalPlayer:GetAttribute("DistanceSinceEvolve")) or 0)
end

local function GetTotalMoves()
    return math.max(0, tonumber(LocalPlayer:GetAttribute("TotalMoves")) or 0)
end

local function DestroyStudFarmWall()
    if StudFarmWall then
        pcall(function()
            StudFarmWall:Destroy()
        end)
    end
    StudFarmWall = nil
end

local function SetStudFarmPhase(phase)
    StudFarmPhase = phase
    StudFarmPhaseSince = os.clock()
end

local function ResetStudFarm(resetCounters)
    DestroyStudFarmWall()

    StudFarmPhase = "idle"
    StudFarmPhaseSince = 0
    StudFarmLastLaunchAttempt = 0
    StudFarmLastRelaunchAttempt = 0
    StudFarmRunStartTotal = GetTotalDistance()
    StudFarmLaunchPosition = nil
    StudFarmCrashAttempts = 0

    if resetCounters then
        StudFarmSessionStartTotal = GetTotalDistance()
        StudFarmRuns = 0
        StudFarmLastGain = 0
    end
end

local function _StopStudFarm(reason)
    State.StudFarm = false
    ResetStudFarm(false)

    if StudFarmToggleControl then
        pcall(function()
            StudFarmToggleControl.Set(false)
        end)
    end

    if reason then
        warn("[Charles's Rocket Rush Tool] Stud Farm stopped: " .. tostring(reason))
    end
end

local function BuildStudFarmWall(position, direction)
    DestroyStudFarmWall()

    local wall = Instance.new("Part")
    wall.Name = "Charles_StudFarm_CrashWall"
    wall.Anchored = true
    wall.CanCollide = true
    wall.CanTouch = true
    wall.CanQuery = true
    wall.CastShadow = false
    wall.Material = Enum.Material.Neon
    wall.Transparency = 0.15
    wall.Color = Color3.fromRGB(255, 80, 95)
    wall.Size = Vector3.new(1200, 1200, 24)

    -- Part Z is the thin axis.  Face the wall back toward the incoming rocket.
    wall.CFrame = CFrame.lookAt(
        position,
        position - direction,
        Vector3.new(0, 1, 0)
    )

    wall.Parent = Workspace
    StudFarmWall = wall
    return wall
end

local function StageMillionStudCrash(state)
    if not state or state.Mode ~= "flight" or not state.API then
        return false
    end

    local startPosition = StudFarmLaunchPosition or state.Position
    if typeof(startPosition) ~= "Vector3" then
        return false
    end

    local look = state.Rotation and state.Rotation.LookVector or Vector3.new(0, 0, -1)
    local horizontal = Vector3.new(look.X, 0, look.Z)

    if horizontal.Magnitude < 0.05 then
        horizontal = Vector3.new(1, 0, 0)
    else
        horizontal = horizontal.Unit
    end


    local destination = Vector3.new(
        startPosition.X,
        startPosition.Y + State.StudFarmSafeAltitude,
        startPosition.Z
    ) + horizontal * State.StudFarmDistance

    BuildStudFarmWall(destination, horizontal)

    local missile = state.Missile or GetLocalMissile()
    local missileHalf = GetMissileExtent(missile)
    local gap = math.max(State.StudFarmWallGap, missileHalf + 18)
    local stagePosition = destination - horizontal * gap
    local rotation = CFrame.lookAt(stagePosition, destination, Vector3.new(0, 1, 0)).Rotation
    local velocity = horizontal * State.StudFarmCrashSpeed

    pcall(function()
        state.API.set(
            stagePosition,
            velocity,
            rotation,
            rotation,
            rotation,
            state.Fuel,
            state.Yaw,
            state.Pitch
        )
    end)

    if missile then
        if missile:IsA("Model") then
            if MissileRig and type(MissileRig.place) == "function" then
                pcall(function()
                    MissileRig.place(missile, CFrame.new(stagePosition) * rotation)
                end)
            else
                pcall(function()
                    missile:PivotTo(CFrame.new(stagePosition) * rotation)
                end)
            end
        elseif missile:IsA("BasePart") then
            pcall(function()
                missile.CFrame = CFrame.new(stagePosition) * rotation
                missile.AssemblyLinearVelocity = velocity
            end)
        end
    end

    return true
end

local function StartStudFarm()
    State.AutoCompleteWorld1 = false
    State.MoveFarm = false
    ResetWorld1AutoComplete()
    ResetMoveFarm(false)

    if World1AutoToggleControl then
        pcall(function()
            World1AutoToggleControl.Set(false)
        end)
    end

    if MoveFarmToggleControl then
        pcall(function()
            MoveFarmToggleControl.Set(false)
        end)
    end

    ResetStudFarm(true)
    SetStudFarmPhase("launch")

    print(
        "[Million Stud Farm] Started at TotalDistance",
        math.floor(StudFarmSessionStartTotal),
        "| requested crash distance",
        math.floor(State.StudFarmDistance)
    )
end

local function StepStudFarm()
    if not State.StudFarm then
        return
    end

    local now = os.clock()
    local state = GetMissileClientState()
    local mode = state and state.Mode or nil

    if StudFarmPhase == "idle" then
        SetStudFarmPhase("launch")
    end

    ------------------------------------------------------
    -- LAUNCH A REAL RUN FIRST
    ------------------------------------------------------

    if StudFarmPhase == "launch" then
        if state and mode == "flight" then
            StudFarmRunStartTotal = GetTotalDistance()
            StudFarmLaunchPosition = state.Position
            StudFarmCrashAttempts = 0
            SetStudFarmPhase("arm crash")
            return
        end

        if now - StudFarmLastLaunchAttempt >= 0.75 then
            StudFarmLastLaunchAttempt = now
            TapKey(Enum.KeyCode.Space)
        end

        return
    end

    ------------------------------------------------------
    -- TELEPORT ~1,000,000 STUDS AND AIM AT LOCAL WALL
    ------------------------------------------------------

    if StudFarmPhase == "arm crash" then
        if not state or mode ~= "flight" then
            SetStudFarmPhase("launch")
            return
        end

        StudFarmCrashAttempts += 1

        if StageMillionStudCrash(state) then
            SetStudFarmPhase("hit wall")
        end

        return
    end

    ------------------------------------------------------
    -- LET MISSILECLIENT RAYCAST INTO THE WALL
    ------------------------------------------------------

    if StudFarmPhase == "hit wall" then
        if not state or mode ~= "flight" then
            DestroyStudFarmWall()
            SetStudFarmPhase("credit")
            return
        end

        -- If the first approach somehow misses because of a frame hitch, put
        -- the rocket immediately in front of the same wall and try again.
        if now - StudFarmPhaseSince >= 1.25 then
            if StudFarmCrashAttempts >= 3 then
                warn("[Million Stud Farm] The local crash wall was not hit after 3 attempts; retrying a new run.")
                DestroyStudFarmWall()
                SetStudFarmPhase("relaunch")
                return
            end

            SetStudFarmPhase("arm crash")
        end

        return
    end

    ------------------------------------------------------
    -- ONLY CALL IT SUCCESSFUL IF SERVER TOTALDISTANCE MOVES
    ------------------------------------------------------

    if StudFarmPhase == "credit" then
        local total = GetTotalDistance()

        if total > StudFarmRunStartTotal then
            StudFarmLastGain = total - StudFarmRunStartTotal
            StudFarmRuns += 1

            print(
                string.format(
                    "[Million Stud Farm] Run %d credited +%d studs | TotalDistance %d",
                    StudFarmRuns,
                    math.floor(StudFarmLastGain + 0.5),
                    math.floor(total + 0.5)
                )
            )

            SetStudFarmPhase("relaunch")
            return
        end

        if now - StudFarmPhaseSince >= State.StudFarmCreditTimeout then
            StudFarmLastGain = 0
            warn(
                "[Million Stud Farm] Server TotalDistance did not increase. The game may be clamping/rejecting that run distance; retrying."
            )
            SetStudFarmPhase("relaunch")
        end

        return
    end

    ------------------------------------------------------
    -- RELAUNCH
    ------------------------------------------------------

    if StudFarmPhase == "relaunch" then
        DestroyStudFarmWall()

        if state and mode == "launch" then
            SetStudFarmPhase("launch")
            return
        end

        local unlockDelay = State.StudFarmRelaunchDelay

        if Landing and type(Landing.get) == "function" then
            local ok, result = pcall(Landing.get, "RelaunchUnlock")
            if ok and type(result) == "number" then
                unlockDelay = math.max(unlockDelay, result + 0.15)
            end
        end

        if now - StudFarmPhaseSince >= unlockDelay
            and now - StudFarmLastRelaunchAttempt >= 0.75 then

            StudFarmLastRelaunchAttempt = now
            TapKey(Enum.KeyCode.R)
        end

        return
    end
end

--==========================================================
-- MOVE FARM
--==========================================================
--
-- The global leaderboard maps:
--     Moves -> TotalMoves
--
-- MissileClient recognizes these actual rocket tricks:
--     Backflip, Frontflip, Roll = BARREL ROLL, Spin = FLAT SPIN
--
-- Each completed trick also sends MissileEvent("QuestTrick"), which is the
-- same path used by the normal client for trick quests / move progression.

function ResetMoveFarm(resetCounters)
    MoveFarmLastLaunchAttempt = 0
    MoveFarmSafePosition = nil
    MoveFarmAccumulated = 0
    MoveFarmCycleIndex = 1
    MoveFarmLastTotal = GetTotalMoves()

    if resetCounters then
        MoveFarmSessionStart = GetTotalMoves()
        MoveFarmRecognized = 0
    end
end

local function CurrentMoveFarmType()
    if State.MoveFarmType ~= "Cycle" then
        return State.MoveFarmType
    end

    return MoveFarmTypes[MoveFarmCycleIndex]
end

local function MoveDeltaCFrame(moveType, radians)
    if moveType == "Backflip" then
        return CFrame.Angles(radians, 0, 0)
    elseif moveType == "Frontflip" then
        return CFrame.Angles(-radians, 0, 0)
    elseif moveType == "Barrel Roll" then
        return CFrame.Angles(0, 0, radians)
    else
        -- Flat Spin
        return CFrame.Angles(0, radians, 0)
    end
end

local function StartMoveFarm()
    State.StudFarm = false
    State.AutoCompleteWorld1 = false
    ResetStudFarm(false)
    ResetWorld1AutoComplete()

    if StudFarmToggleControl then
        pcall(function()
            StudFarmToggleControl.Set(false)
        end)
    end

    if World1AutoToggleControl then
        pcall(function()
            World1AutoToggleControl.Set(false)
        end)
    end

    ResetMoveFarm(true)

    print(
        "[Move Farm] Started. TotalMoves =",
        math.floor(GetTotalMoves()),
        "| mode =",
        State.MoveFarmType
    )
end

local function StepMoveFarm(dt)
    if not State.MoveFarm then
        return
    end

    local state = GetMissileClientState()
    local now = os.clock()

    if not state or state.Mode ~= "flight" then
        MoveFarmSafePosition = nil

        if now - MoveFarmLastLaunchAttempt >= 0.75 then
            MoveFarmLastLaunchAttempt = now
            TapKey(Enum.KeyCode.Space)
        end

        return
    end

    local missile = state.Missile or GetLocalMissile()

    if not MoveFarmSafePosition then
        MoveFarmSafePosition = state.Position + Vector3.new(0, State.MoveFarmSafeAltitude, 0)
    end

    local moveType = CurrentMoveFarmType()
    local radians = math.rad(State.MoveFarmDegreesPerSecond) * math.max(dt, 1 / 240)
    radians = math.clamp(radians, math.rad(1), math.rad(28))

    local baseRotation = state.Rotation or CFrame.identity
    local newRotation = baseRotation * MoveDeltaCFrame(moveType, radians)

    pcall(function()
        state.API.set(
            MoveFarmSafePosition,
            Vector3.zero,
            newRotation,
            newRotation,
            newRotation,
            state.Fuel,
            state.Yaw,
            state.Pitch
        )
    end)

    if missile then
        if missile:IsA("Model") then
            if MissileRig and type(MissileRig.place) == "function" then
                pcall(function()
                    MissileRig.place(missile, CFrame.new(MoveFarmSafePosition) * newRotation)
                end)
            else
                pcall(function()
                    missile:PivotTo(CFrame.new(MoveFarmSafePosition) * newRotation)
                end)
            end
        elseif missile:IsA("BasePart") then
            pcall(function()
                missile.CFrame = CFrame.new(MoveFarmSafePosition) * newRotation
                missile.AssemblyLinearVelocity = Vector3.zero
                missile.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end

    MoveFarmAccumulated += math.abs(radians)

    -- Swap tricks after a full visual revolution when Cycle is selected.
    if MoveFarmAccumulated >= math.rad(360) then
        MoveFarmAccumulated -= math.rad(360)

        if State.MoveFarmType == "Cycle" then
            MoveFarmCycleIndex += 1
            if MoveFarmCycleIndex > #MoveFarmTypes then
                MoveFarmCycleIndex = 1
            end
        end
    end

    local totalMoves = GetTotalMoves()
    if totalMoves > MoveFarmLastTotal then
        MoveFarmRecognized += totalMoves - MoveFarmLastTotal
        MoveFarmLastTotal = totalMoves
    elseif totalMoves < MoveFarmLastTotal then
        MoveFarmLastTotal = totalMoves
    end
end


local function FireTargetHit(target)
    if not TargetHit or not IsTargetAlive(target) then
        return false
    end

    local missileRoot = GetMissileRoot()
    local referencePosition =
        missileRoot and missileRoot.Position
        or GetTargetPosition(target)

    if not referencePosition then
        return false
    end

    -- Send an actual point on the vehicle's bounding surface instead of its
    -- center. With the rocket now sitting OUTSIDE the hull, this makes the hit
    -- position correspond to the side of the vehicle facing the missile.
    local hitPosition =
        GetClosestPointOnTargetBounds(
            target,
            referencePosition
        )

    if not hitPosition then
        return false
    end

    local ok = pcall(function()
        TargetHit:FireServer(
            target,
            hitPosition,
            nil,
            0,
            1,
            "mini"
        )
    end)

    return ok
end

local function ClearCurrentFarmTarget()
    CurrentFarmTarget = nil
    CurrentFarmTargetSince = 0
end

local function SelectBestFarmTarget()
    if #TargetCache == 0 then
        RebuildTargetCache()
    end

    local target = GetBestTarget()
    CurrentFarmTarget = target
    CurrentFarmTargetSince = os.clock()
    return target
end

local function StepBestVehicleFarm()
    if not State.AutoTargetFarm then
        ClearCurrentFarmTarget()
        return
    end

    -- Do not teleport the rocket while it is still sitting in the launcher.
    -- Wait until MissileClient has entered its real "flight" state first.
    -- This prevents launcher/rocket rig pieces from being separated.
    local missileRoot = GetMissileRoot()
    local flying = IsMissileFlying()

    if not missileRoot or not flying then
        if os.clock() - LastFarmTeleport > 0.8 then
            LastFarmTeleport = os.clock()
            TapKey(Enum.KeyCode.Space)
        end
        return
    end

    if not IsTargetAllowed(CurrentFarmTarget) then
        SelectBestFarmTarget()
    end

    local target = CurrentFarmTarget
    if not target then
        RebuildTargetCache()
        target = SelectBestFarmTarget()
        if not target then
            return
        end
    end

    local now = os.clock()

    -- If the server never marks the target destroyed, refresh selection after
    -- a short timeout rather than getting permanently stuck on one vehicle.
    if CurrentFarmTargetSince > 0
        and now - CurrentFarmTargetSince >= State.FarmKillTimeout then

        RebuildTargetCache()
        target = SelectBestFarmTarget()
        if not target then
            return
        end
    end

    -- Keep the missile close to the active best-value vehicle.
    if now - LastFarmTeleport >= 0.08 then
        LastFarmTeleport = now
        TeleportMissileToTarget(target)
    end

    -- Hit it repeatedly until the server marks it destroyed.
    if now - LastFarmHit >= State.FarmDelay then
        LastFarmHit = now

        for _ = 1, math.max(1, State.FarmRepeatHits) do
            if not IsTargetAlive(target) then
                break
            end
            FireTargetHit(target)
        end
    end

    if not IsTargetAlive(target) then
        RebuildTargetCache()
