local function TryRequire(parent, name)
    local module = parent and parent:FindFirstChild(name)

    if not module or not module:IsA("ModuleScript") then
        warn("[Charles's Rocket Rush Tool] Optional module missing: " .. tostring(name))
        return nil
    end

    local ok, result = pcall(require, module)

    if not ok then
        warn(
            "[Charles's Rocket Rush Tool] Could not require "
            .. tostring(name)
            .. ": "
            .. tostring(result)
        )
        return nil
    end

    return result
end

