-- AUTO PILOT
--==========================================================

local function StepAutoPilot()
    if not State.AutoPilot or State.AutoTargetFarm then
        return
    end

    local root = GetMissileRoot()
    if not root then
        return
    end

    local target = GetNearestTarget(root.Position)
    if not target then
        return
    end

    local targetPosition = GetTargetPosition(target)
    if not targetPosition then
        return
    end

    local difference = targetPosition - root.Position
    if difference.Magnitude < 1 then
        return
    end

    local direction = difference.Unit

    pcall(function()
        root.AssemblyLinearVelocity = direction * State.FlightSpeed
        root.AssemblyAngularVelocity = Vector3.zero
        root.CFrame = CFrame.lookAt(root.Position, targetPosition)
    end)
end

