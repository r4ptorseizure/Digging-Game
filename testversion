--================================================== 
-- RAYCAST 
--================================================== 
 
local function GetRayParams( 
    Character, 
    Target 
) 
 
    local Params = 
        RaycastParams.new() 
 
    Params.FilterType = 
        Enum.RaycastFilterType.Exclude 
 
    local Ignore = { 
        Character 
    } 
 
    if Target then 
        table.insert( 
            Ignore, 
            Target 
        ) 
    end 
 
    Params.FilterDescendantsInstances = 
        Ignore 
 
    Params.IgnoreWater = false 
 
    return Params 
end 
 
local function IsSegmentClear( 
    StartPosition, 
    EndPosition, 
    Character, 
    Target 
) 
 
    local Direction = 
        EndPosition 
        - StartPosition 
 
    if Direction.Magnitude <= 0.05 then 
        return true 
    end 
 
    local RootPart = 
        Character 
        and Character:FindFirstChild( 
            "HumanoidRootPart" 
        ) 
 
    if not RootPart then 
        return false 
    end 
 
    local Margin = 
        math.max( 
            SETTINGS.PATH_BLOCKCAST_MARGIN, 
            0 
        ) 
 
    local CastSize = 
        RootPart.Size 
        + Vector3.new( 
            Margin, 
            Margin, 
            Margin 
        ) 
 
    local Result = 
        Workspace:Blockcast( 
            CFrame.new( 
                StartPosition 
            ), 
            CastSize, 
            Direction, 
            GetRayParams( 
                Character, 
                Target 
            ) 
        ) 
 
    if Result then 
        return false 
    end 
 
    return true 
end 
 
--================================================== 
-- GROUND 
--================================================== 
 
local function GetGroundY( 
    Position, 
    Character 
) 
 
    local Params = 
        GetRayParams( 
            Character 
        ) 
 
    local Origin = 
        Position 
        + Vector3.new( 
            0, 
            6, 
            0 
        ) 
 
    local Direction = 
        Vector3.new( 
            0, 
            -SETTINGS.GROUND_RAY_DISTANCE, 
            0 
        ) 
 
    local Result = 
        Workspace:Raycast( 
            Origin, 
            Direction, 
            Params 
        ) 
 
    if Result then 
        return Result.Position.Y 
    end 
 
    return nil 
end 
 
local function GetSafeHeight( 
    Position, 
    Character 
) 
 
    local GroundY = 
        GetGroundY( 
            Position, 
            Character 
        ) 
 
    if not GroundY then 
        return Position.Y 
    end 
 
    local Humanoid = 
        Character:FindFirstChildOfClass( 
            "Humanoid" 
        ) 
 
    local RootPart = 
        Character:FindFirstChild( 
            "HumanoidRootPart" 
        ) 
 
    local Height = 
        SETTINGS.GROUND_CLEARANCE 
 
    if Humanoid 
        and RootPart 
    then 
 
        Height = 
            math.max( 
                SETTINGS.GROUND_CLEARANCE, 
                Humanoid.HipHeight 
                    + RootPart.Size.Y / 2 
            ) 
    end 
 
    return math.max( 
        Position.Y, 
        GroundY + Height 
    ) 
end 
 
--================================================== 
-- DIRECT TWEEN 
--================================================== 
 
local function DirectTween( 
    TargetPosition, 
    Speed, 
    Target 
) 
 
    local RootPart, Character = 
        GetRootPart() 
 
    if not RootPart then 
        return false 
    end 
 
    local Distance = 
        ( 
            RootPart.Position 
            - TargetPosition 
        ).Magnitude 
 
    if Distance <= 
        SETTINGS.POSITION_TOLERANCE 
    then 
        return true 
    end 
 
    local Duration = 
        math.max( 
            Distance / Speed, 
            SETTINGS.MIN_TWEEN_DURATION 
        ) 
 
    local Tween = 
        TweenService:Create( 
 
            RootPart, 
 
            TweenInfo.new( 
                Duration, 
                Enum.EasingStyle.Linear 
            ), 
 
            { 
                CFrame = 
                    CFrame.new( 
                        TargetPosition 
                    ) 
            } 
        ) 
 
    local Finished = false 
 
    local Connection = 
        Tween.Completed:Connect( 
            function() 
                Finished = true 
            end 
        ) 
 
    Tween:Play() 
 
    local Timeout = 
        os.clock() 
        + math.max( 
            SETTINGS.MOVEMENT_TIMEOUT, 
            Duration + 2 
        ) 
 
    while 
        ScriptRunning 
        and not Finished 
        and os.clock() < Timeout 
    do 
 
        if not RootPart.Parent then 
            Tween:Cancel() 
            break 
        end 
 
        task.wait() 
    end 
 
    if not Finished then 
        Tween:Cancel() 
    end 
 
    Connection:Disconnect() 
 
    return ( 
        RootPart.Position 
        - TargetPosition 
    ).Magnitude 
        <= math.max( 
            SETTINGS.POSITION_TOLERANCE, 
            2 
        ) 
end 
 
