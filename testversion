local function Shutdown() 
 
    if not ScriptRunning then 
        return 
    end 
 
    ScriptRunning = false 
 
    AutoCollect = false 
    AutoShake = false 
    AutoSell = false 
    AutoFarm = false 
    FastPathEnabled = false 
 
    for _, Connection in pairs( 
        Connections 
    ) do 
 
        pcall(function() 
 
            if Connection then 
                Connection:Disconnect() 
            end 
        end) 
    end 
 
    Connections = {} 
 
    if ScreenGui then 
        ScreenGui:Destroy() 
    end 
end 
 
