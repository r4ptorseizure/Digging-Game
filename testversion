--================================================== 
-- PATH TWEEN 
--================================================== 
 
local function FollowPath( 
    TargetPosition, 
    Target, 
    SafeMode 
) 
 
    local RootPart, Character = 
        GetRootPart() 
 
    if not RootPart then 
        return false 
    end 
 
    local RepathCount = 0 
    local MaxRepaths = 6 
 
    while ScriptRunning do 
 
        if Target 
            and not Target.Parent 
        then 
            return false 
        end 
 
        local CurrentRoot, 
            CurrentCharacter = 
            GetRootPart() 
 
        if not CurrentRoot then 
            return false 
        end 
 
        RootPart = 
            CurrentRoot 
 
        Character = 
            CurrentCharacter 
 
        local Path = 
            CreatePath( 
                RootPart.Position, 
                TargetPosition 
            ) 
 
        if not Path then 
            return false 
        end 
 
        local Waypoints = 
            Path:GetWaypoints() 
 
        if #Waypoints == 0 then 
            return false 
        end 
 
        local NeedRepath = false 
 
        for Index, Waypoint in ipairs( 
            Waypoints 
        ) do 
 
            if not ScriptRunning then 
                return false 
            end 
 
            if Target 
                and not Target.Parent 
            then 
                return false 
            end 
 
            local CurrentRoot, 
                CurrentCharacter = 
                GetRootPart() 
 
            if not CurrentRoot then 
                return false 
            end 
 
            RootPart = 
                CurrentRoot 
 
            Character = 
                CurrentCharacter 
 
            local WaypointPosition = 
                Waypoint.Position 
 
            if ( 
                RootPart.Position 
                - WaypointPosition 
            ).Magnitude 
                <= SETTINGS.POSITION_TOLERANCE 
            then 
                continue 
            end 
 
            if SafeMode then 
 
                local Clear = 
                    IsSegmentClear( 
                        RootPart.Position, 
                        WaypointPosition, 
                        Character, 
                        Target 
                    ) 
 
                if not Clear then 
 
                    NeedRepath = true 
                    break 
                end 
            end 
 
            if Waypoint.Action == 
                Enum.PathWaypointAction.Jump 
            then 
 
                local Humanoid = 
                    Character: 
                        FindFirstChildOfClass( 
                            "Humanoid" 
                        ) 
 
                if Humanoid then 
                    Humanoid.Jump = true 
                end 
            end 
 
            local Success = 
                DirectTween( 
                    WaypointPosition, 
                    SETTINGS.FAST_PATH_SPEED, 
                    Target 
                ) 
 
            if not Success then 
 
                if SafeMode then 
                    NeedRepath = true 
                    break 
                end 
 
                return false 
            end 
        end 
 
        if not NeedRepath then 
 
            if Target 
                and Target.Parent 
            then 
                TargetPosition = 
                    Target.Position 
            end 
 
            local FinalRoot, 
                FinalCharacter = 
                GetRootPart() 
 
            if not FinalRoot then 
                return false 
            end 
 
            if SafeMode then 
 
                local FinalClear = 
                    IsSegmentClear( 
                        FinalRoot.Position, 
                        TargetPosition, 
                        FinalCharacter, 
                        Target 
                    ) 
 
                if not FinalClear then 
 
                    RepathCount += 1 
 
                    if RepathCount > 
                        MaxRepaths 
                    then 
                        return false 
                    end 
 
                    continue 
                end 
            end 
 
            return DirectTween( 
                TargetPosition, 
                SETTINGS.FAST_PATH_SPEED, 
                Target 
            ) 
        end 
 
        RepathCount += 1 
 
        if RepathCount > 
            MaxRepaths 
        then 
            return false 
        end 
 
        task.wait(0.03) 
    end 
 
    return false 
end 
 
--================================================== 
-- MOVEMENT DISPATCHER 
--================================================== 
 
local function MoveToTarget( 
    TargetPosition, 
    Target 
) 
 
    if not ScriptRunning then 
        return false 
    end 
 
    if MovementMode == "Tween" then 
 
        return DirectTween( 
            TargetPosition, 
            SETTINGS.FAST_PATH_SPEED, 
            Target 
        ) 
    end 
 
    if MovementMode == "Path Tween" then 
 
        local Success = 
            FollowPath( 
                TargetPosition, 
                Target, 
                false 
            ) 
 
        if Success then 
            return true 
        end 
 
        return false 
    end 
 
    if MovementMode == "Safe Tween" then 
 
        local Success = 
            FollowPath( 
                TargetPosition, 
                Target, 
                true 
            ) 
 
        if Success then 
            return true 
        end 
 
        local RootPart = 
            GetRootPart() 
 
        if not RootPart then 
            return false 
        end 
 
        if Target 
            and Target.Parent 
        then 
            TargetPosition = 
                Target.Position 
        end 
 
        return FollowPath( 
            TargetPosition, 
            Target, 
            true 
        ) 
    end 
 
    return false 
end 
 
