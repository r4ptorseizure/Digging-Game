--================================================== 
-- GEODE TARGET SCANNER 
--================================================== 
 
local FailedGeodeTargets = {} 
 
local function IsFailedGeodeTarget( 
    Target 
) 
 
    if not Target then 
        return false 
    end 
 
    local FailedUntil = 
        FailedGeodeTargets[Target] 
 
    if not FailedUntil then 
        return false 
    end 
 
    if os.clock() >= FailedUntil then 
        FailedGeodeTargets[Target] = nil 
        return false 
    end 
 
    return true 
end 
 
local function MarkFailedGeodeTarget( 
    Target 
) 
 
    if not Target then 
        return 
    end 
 
    FailedGeodeTargets[Target] = 
        os.clock() 
        + math.max( 
            SETTINGS.GEODE_FAILED_TARGET_COOLDOWN, 
            0.25 
        ) 
end 
 
local function GetGeodeTargets() 
 
    local Geode = 
        GetGeode() 
 
    if not Geode then 
        return {} 
    end 
 
    local Character = 
        LocalPlayer.Character 
 
    local Targets = {} 
 
    for _, Object in ipairs( 
        Geode:GetDescendants() 
    ) do 
 
        if IsGeodeTarget( 
            Object, 
            Character 
        ) 
            and not IsFailedGeodeTarget( 
                Object 
            ) 
        then 
 
            local LowerName = 
                string.lower( 
                    Object.Name 
                ) 
 
            if not LowerName:find( 
                "status", 
                1, 
                true 
            ) then 
 
                table.insert( 
                    Targets, 
                    Object 
                ) 
            end 
        end 
    end 
 
    return Targets 
end 
 
local function FindClosestGeodeTarget() 
 
    local RootPart = 
        GetRootPart() 
 
    if not RootPart then 
        return nil 
    end 
 
    local Targets = 
        GetGeodeTargets() 
 
    local Closest = nil 
    local ClosestDistance = 
        math.huge 
 
    for _, Target in ipairs( 
        Targets 
    ) do 
 
        if Target.Parent then 
 
            local Distance = 
                ( 
                    RootPart.Position 
                    - Target.Position 
                ).Magnitude 
 
            if Distance < 
                ClosestDistance 
            then 
 
                ClosestDistance = 
                    Distance 
 
                Closest = 
                    Target 
            end 
        end 
    end 
 
    return Closest 
end 
 
