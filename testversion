    end 
 
    local NearestMerchant = nil 
    local NearestDistance = math.huge 
 
    for _, Object in ipairs(NPCs:GetDescendants()) do 
 
        if Object:IsA("Model") then 
 
            local LowerName = 
                string.lower(Object.Name) 
 
            if LowerName:find("merchant", 1, true) then 
 
                local MerchantRoot = 
                    Object:FindFirstChild( 
                        "HumanoidRootPart", 
                        true 
                    ) 
 
                if not MerchantRoot then 
                    MerchantRoot = 
                        Object:FindFirstChildWhichIsA( 
                            "BasePart", 
                            true 
                        ) 
                end 
 
                if MerchantRoot then 
 
                    local Distance = 
                        ( 
                            RootPart.Position 
                            - MerchantRoot.Position 
                        ).Magnitude 
 
                    if Distance < NearestDistance then 
 
                        NearestDistance = 
                            Distance 
 
                        NearestMerchant = 
                            MerchantRoot 
                    end 
                end 
            end 
        end 
    end 
 
    return NearestMerchant 
end 
 
local function GoToNearestMerchant() 
 
    local Merchant = 
        GetNearestMerchant() 
 
    if not Merchant then 
 
        warn( 
            "[Auto Farm] No merchant found." 
        ) 
 
        return false 
    end 
 
    print( 
        "[Auto Farm] Going to:", 
        Merchant:GetFullName() 
    ) 
 
    return MoveToTarget( 
        Merchant.Position, 
        Merchant 
    ) 
end 
 
--================================================== 
-- AUTO FARM 
--================================================== 
 
local function RunAutoFarm() 
 
    if AutoFarmThread then 
        return 
    end 
 
    AutoFarmThread = 
        task.spawn(function() 
 
            while 
                AutoFarm 
                and ScriptRunning 
            do 
 
                --========================================== 
                -- SCAN PAN 
                --========================================== 
 
                ScanForPan() 
                UpdateSandDisplay() 
 
                if not CurrentPan then 
 
                    task.wait(1) 
 
                    continue 
                end 
 
                --========================================== 
                -- SELECT LOCATION 
                --========================================== 
 
                local Location = 
                    LOCATIONS[ 
                        SelectedLocation 
                    ] 
 
                if not Location then 
 
                    task.wait(1) 
 
                    continue 
                end 
 
                --========================================== 
                -- CHECK BACKPACK 
                --========================================== 
 
                local CurrentSpace, 
                    MaxSpace = 
                    GetBackpackCapacity() 
 
                if MaxSpace <= 0 then 
 
                    task.wait(0.5) 
 
                    continue 
                end 
 
                --========================================== 
                -- BACKPACK ALREADY FULL 
                --========================================== 
 
                if CurrentSpace >= MaxSpace then 
 
                    if AutoSell then 
 
                        local Sold = 
                            GoToNearestMerchant() 
 
                        if Sold then 
 
                            task.wait(0.5) 
 
                            SellAll() 
 
                            task.wait( 
                                SETTINGS.AUTO_SELL_DELAY 
                            ) 
 
                        else 
 
                            task.wait(0.5) 
 
                            continue 
                        end 
 
                    else 
 
                        -- Auto Sell is OFF. 
                        -- Do not travel to merchant. 
                        -- Continue with the normal farm cycle. 
 
                        task.wait(0.5) 
                    end 
 
                    if not AutoFarm 
                        or not ScriptRunning 
                    then 
                        break 
                    end 
                end 
 
                --========================================== 
                -- GO TO SAND 
                --========================================== 
 
                if not MoveToTarget( 
                    Location.Sand, 
                    nil 
                ) then 
 
                    task.wait(0.5) 
 
                    continue 
                end 
 
                if not AutoFarm 
                    or not ScriptRunning 
                then 
                    break 
                end 
 
                --========================================== 
                -- COLLECT UNTIL PAN CAPACITY IS FULL 
                --========================================== 
 
                while 
                    AutoFarm 
                    and ScriptRunning 
                do 
 
                    local Fill, 
                        Capacity = 
                        GetSand() 
 
                    UpdateSandDisplay() 
 
                    if Capacity <= 0 then 
 
                        task.wait(0.5) 
 
                        continue 
                    end 
 
                    if Fill >= Capacity then 
                        break 
                    end 
 
                    Collect() 
 
                    task.wait( 
                        SETTINGS.AUTO_COLLECT_DELAY 
                    ) 
                end 
 
                if not AutoFarm 
                    or not ScriptRunning 
                then 
                    break 
                end 
 
                --========================================== 
                -- BACKPACK FULL -> MERCHANT 
                --========================================== 
 
                local CurrentSpaceBeforeSell, 
                    MaxSpaceBeforeSell = 
                    GetBackpackCapacity() 
 
                if MaxSpaceBeforeSell > 0 
                    and CurrentSpaceBeforeSell >= 
                        MaxSpaceBeforeSell 
                then 
 
                    if AutoSell then 
 
                        local Sold = 
                            GoToNearestMerchant() 
 
                        if Sold then 
 
                            task.wait(0.5) 
 
                            SellAll() 
 
                            task.wait( 
                                SETTINGS.AUTO_SELL_DELAY 
                            ) 
 
                        else 
 
                            -- Merchant could not be found. 
                            task.wait(0.5) 
                        end 
                    end 
                end 
 
                if not AutoFarm 
                    or not ScriptRunning 
                then 
                    break 
                end 
 
                --========================================== 
                -- RETURN TO SAND AFTER SELL 
                --========================================== 
 
                if AutoSell 
                    and MaxSpaceBeforeSell > 0 
                    and CurrentSpaceBeforeSell >= 
                        MaxSpaceBeforeSell 
                then 
 
                    if not MoveToTarget( 
                        Location.Sand, 
                        nil 
                    ) then 
 
                        task.wait(0.5) 
 
                        continue 
                    end 
                end 
 
                if not AutoFarm 
                    or not ScriptRunning 
                then 
                    break 
                end 
 
                --========================================== 
                -- GO TO WATER 
                -- ORIGINAL WATER TWEEN 
                --========================================== 
 
                if not MoveToTarget( 
                    Location.Water, 
                    nil 
                ) then 
 
                    task.wait(0.5) 
 
                    continue 
                end 
 
                if not AutoFarm 
                    or not ScriptRunning 
                then 
                    break 
                end 
 
                --========================================== 
                -- START WATER PAN 
                --========================================== 
 
                task.wait(0.75) 
 
                local Started = 
                    StartWaterPan() 
 
                if not Started then 
 
                    task.wait(0.5) 
 
                    continue 
                end 
 
                --========================================== 
                -- SHAKE WHILE PANNING 
                --========================================== 
 
                ShakeWhilePanning() 
 
                if not AutoFarm 
                    or not ScriptRunning 
                then 
                    break 
                end 
 
                --========================================== 
                -- BACKPACK FULL AFTER PANNING -> MERCHANT 
                --========================================== 
 
                local CurrentSpaceAfterPan, 
                    MaxSpaceAfterPan = 
                    GetBackpackCapacity() 
 
                if AutoSell 
                    and MaxSpaceAfterPan > 0 
                    and CurrentSpaceAfterPan >= 
                        MaxSpaceAfterPan 
                then 
 
                    local Sold = 
                        GoToNearestMerchant() 
 
                    if Sold then 
 
                        task.wait(0.5) 
 
                        SellAll() 
 
                        task.wait( 
                            SETTINGS.AUTO_SELL_DELAY 
                        ) 
 
                        if not AutoFarm 
                            or not ScriptRunning 
                        then 
                            break 
                        end 
 
                        --========================================== 
                        -- RETURN TO SAND AFTER POST-WATER SELL 
                        --========================================== 
 
                        if not MoveToTarget( 
                            Location.Sand, 
                            nil 
                        ) then 
 
                            task.wait(0.5) 
 
                            continue 
                        end 
 
                    else 
 
                        task.wait(0.5) 
                    end 
                end 
 
                if not AutoFarm 
                    or not ScriptRunning 
                then 
                    break 
                end 
 
                --========================================== 
                -- NEXT CYCLE 
                --========================================== 
 
                task.wait(0.25) 
            end 
 
            AutoFarmThread = nil 
        end) 
end 
 
