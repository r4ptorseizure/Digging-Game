-- SETTINGS SAVE / LOAD 
--================================================== 
 
local SETTINGS_FILE = "CharlesAutoTool_Settings.json" 
 
local function SaveSettings() 
    if not writefile or not HttpService then 
        return 
    end 
 
    local Success, Data = pcall(function() 
        return HttpService:JSONEncode(SETTINGS) 
    end) 
 
    if Success then 
        pcall(function() 
            writefile(SETTINGS_FILE, Data) 
        end) 
    end 
end 
 
local function LoadSettings() 
    if not readfile or not isfile or not HttpService then 
        return 
    end 
 
    if not isfile(SETTINGS_FILE) then 
        return 
    end 
 
    local Success, Data = pcall(function() 
        return readfile(SETTINGS_FILE) 
    end) 
 
    if not Success then 
        return 
    end 
 
    local DecodeSuccess, SavedSettings = 
        pcall(function() 
            return HttpService:JSONDecode(Data) 
        end) 
 
    if not DecodeSuccess 
        or type(SavedSettings) ~= "table" 
    then 
        return 
    end 
 
    for Key, Value in pairs(SavedSettings) do 
 
        if SETTINGS[Key] ~= nil 
            and type(Value) == type(SETTINGS[Key]) 
        then 
            SETTINGS[Key] = Value 
        end 
    end 
end 
 
LoadSettings() 
 
--================================================== 
-- REMOTE REQUEST SAFETY LIMITER 
--================================================== 
 
local REQUEST_LIMITER = { 
    MAX_REQUESTS_PER_SECOND = 50, 
    WINDOW = 1, 
    Requests = {} 
} 
 
local function CanSendRemote() 
    local Now = os.clock() 
    local Requests = REQUEST_LIMITER.Requests 
 
    for i = #Requests, 1, -1 do 
        if Now - Requests[i] >= REQUEST_LIMITER.WINDOW then 
            table.remove(Requests, i) 
        end 
    end 
 
    if #Requests >= REQUEST_LIMITER.MAX_REQUESTS_PER_SECOND then 
        return false 
    end 
 
    table.insert(Requests, Now) 
    return true 
end 
 
