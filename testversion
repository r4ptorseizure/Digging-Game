local function ScanForPan() 
 
    if not ScriptRunning then 
        return 
    end 
 
    local Character = 
        LocalPlayer.Character 
 
    if not Character then 
 
        CurrentPan = nil 
        CurrentCollect = nil 
        CurrentShake = nil 
        CurrentPanRemote = nil 
 
        PanStatus.Text = 
            "Pan: None equipped" 
 
        return 
    end 
 
    local FoundPan = nil 
    local FoundCollect = nil 
    local FoundShake = nil 
    local FoundPanRemote = nil 
 
    for _, Object in ipairs( 
        Character:GetChildren() 
    ) do 
 
        if Object:IsA("Tool") then 
 
            local Scripts = 
                Object:FindFirstChild( 
                    "Scripts" 
                ) 
 
            if Scripts then 
 
                local Collect = 
                    Scripts:FindFirstChild( 
                        "Collect" 
                    ) 
 
                local Shake = 
                    Scripts:FindFirstChild( 
                        "Shake" 
                    ) 
 
                local Pan = 
                    Scripts:FindFirstChild( 
                        "Pan" 
                    ) 
 
                if Collect 
                    or Shake 
                    or Pan 
                then 
 
                    FoundPan = Object 
 
                    if Collect 
                        and Collect:IsA( 
                            "RemoteFunction" 
                        ) 
                    then 
                        FoundCollect = 
                            Collect 
                    end 
 
                    if Shake 
                        and Shake:IsA( 
                            "RemoteEvent" 
                        ) 
                    then 
                        FoundShake = 
                            Shake 
                    end 
 
                    if Pan 
                        and Pan:IsA( 
                            "RemoteFunction" 
                        ) 
                    then 
                        FoundPanRemote = 
                            Pan 
                    end 
 
                    break 
                end 
            end 
        end 
    end 
 
    CurrentPan = FoundPan 
    CurrentCollect = FoundCollect 
    CurrentShake = FoundShake 
    CurrentPanRemote = FoundPanRemote 
 
    if CurrentPan then 
 
        PanStatus.Text = 
            "Pan: " 
            .. CurrentPan.Name 
 
        PanStatus.TextColor3 = 
            Color3.fromRGB( 
                180, 
                180, 
                185 
            ) 
 
    else 
 
        PanStatus.Text = 
            "Pan: None equipped" 
 
        PanStatus.TextColor3 = 
            Color3.fromRGB( 
                150, 
                100, 
                100 
            ) 
    end 
end 
 
