-- CUSTOM LOCATION SAVE / LOAD 
-- ADDED 
--================================================== 
 
local CUSTOM_LOCATIONS_FILE = 
    "CharlesAutoTool_Locations.json" 
 
local CustomLocations = {} 
 
local function SaveCustomLocations() 
 
    if not writefile 
        or not HttpService 
    then 
        return 
    end 
 
    local DataToSave = {} 
 
    for _, Location in ipairs(CustomLocations) do 
 
        table.insert( 
            DataToSave, 
            { 
                Name = Location.Name, 
 
                Sand = { 
                    X = Location.Sand.X, 
                    Y = Location.Sand.Y, 
                    Z = Location.Sand.Z 
                }, 
 
                Water = { 
                    X = Location.Water.X, 
                    Y = Location.Water.Y, 
                    Z = Location.Water.Z 
                } 
            } 
        ) 
    end 
 
    local Success, Data = 
        pcall(function() 
            return HttpService:JSONEncode( 
                DataToSave 
            ) 
        end) 
 
    if not Success then 
        warn( 
            "[Locations] Failed to encode locations." 
        ) 
 
        return 
    end 
 
    pcall(function() 
        writefile( 
            CUSTOM_LOCATIONS_FILE, 
            Data 
        ) 
    end) 
end 
 
local function LoadCustomLocations() 
 
    if not readfile 
        or not isfile 
        or not HttpService 
    then 
        return 
    end 
 
    if not isfile( 
        CUSTOM_LOCATIONS_FILE 
    ) then 
        return 
    end 
 
    local Success, Data = 
        pcall(function() 
            return readfile( 
                CUSTOM_LOCATIONS_FILE 
            ) 
        end) 
 
    if not Success then 
        return 
    end 
 
    local DecodeSuccess, SavedLocations = 
        pcall(function() 
            return HttpService:JSONDecode( 
                Data 
            ) 
        end) 
 
    if not DecodeSuccess 
        or type(SavedLocations) ~= "table" 
    then 
        return 
    end 
 
    for _, SavedLocation in ipairs( 
        SavedLocations 
    ) do 
 
        if type(SavedLocation) == "table" 
            and type(SavedLocation.Name) == "string" 
            and type(SavedLocation.Sand) == "table" 
            and type(SavedLocation.Water) == "table" 
        then 
 
            local SX = tonumber( 
                SavedLocation.Sand.X 
            ) 
 
            local SY = tonumber( 
                SavedLocation.Sand.Y 
            ) 
 
            local SZ = tonumber( 
                SavedLocation.Sand.Z 
            ) 
 
            local WX = tonumber( 
                SavedLocation.Water.X 
            ) 
 
            local WY = tonumber( 
                SavedLocation.Water.Y 
            ) 
 
            local WZ = tonumber( 
                SavedLocation.Water.Z 
            ) 
 
            if SX 
                and SY 
                and SZ 
                and WX 
                and WY 
                and WZ 
            then 
 
                local Location = { 
                    Name = SavedLocation.Name, 
                    Sand = Vector3.new( 
                        SX, 
                        SY, 
                        SZ 
                    ), 
                    Water = Vector3.new( 
                        WX, 
                        WY, 
                        WZ 
                    ), 
                    Custom = true 
                } 
 
                table.insert( 
                    CustomLocations, 
                    Location 
                ) 
 
                table.insert( 
                    LOCATIONS, 
                    Location 
                ) 
            end 
        end 
    end 
end 
 
LoadCustomLocations() 
 
