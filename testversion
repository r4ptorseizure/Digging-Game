        DeleteButton.MouseButton1Click:Connect( 
            function() 
 
                local ActualIndex = nil 
 
                for Index, ExistingLocation in 
                    ipairs(LOCATIONS) 
                do 
 
                    if ExistingLocation == Location then 
                        ActualIndex = Index 
                        break 
                    end 
                end 
 
                if ActualIndex then 
 
                    if SelectedLocation == ActualIndex then 
                        SelectedLocation = 1 
 
                        LocationStatus.Text = 
                            "Selected: " 
                            .. LOCATIONS[1].Name 
                    elseif SelectedLocation > ActualIndex then 
                        SelectedLocation -= 1 
                    end 
 
                    table.remove( 
                        LOCATIONS, 
                        ActualIndex 
                    ) 
                end 
 
                table.remove( 
                    CustomLocations, 
                    CustomIndex 
                ) 
 
                SaveCustomLocations() 
                RefreshCustomLevelManager() 
 
                print( 
                    "[Locations] Deleted:", 
                    Location.Name 
                ) 
            end 
        ) 
    end 
 
    task.defer(function() 
 
        CustomLevelScroll.CanvasSize = 
